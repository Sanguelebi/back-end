# =============================================
# Gin Server Settings
# -----
# We might want BUILD_TARGET to be `prod`, and have GIN_MODE to be `debug`,
# to not lose out on a logger from GIN, and yet to test how it will run on  EC2.
# =============================================
# Use 'dev' for dev environment. Switch to 'prod' in EC2
BUILD_TARGET=dev
# Use 'debug' for local development. Switch to 'release' in EC2
GIN_MODE=debug
PORT=8080

# =============================================
# Database Settings (PostgreSQL)
# =============================================
# Local execution: 
#   DB_HOST = localhost
# Running via Doker Compose: 
#   DB_HOST = postgres (matches the docker-compose service name)
DB_HOST=postgres
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password
DB_NAME=course_selection_db
DB_SSLMODE=prefer # Should be prefer at all times

# ==============================================================================
# Security & JWT Tokens 
# ==============================================================================
# JWT_SECRET = A long, random string used to sign user auth tokens.
# -------------------------
# Local execution
#    IS_SECURE=false
# Running on Production:
#    IS_SECURE=true
JWT_SECRET=your_jwt_secret_key_here
IS_SECURE=false