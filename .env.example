# =============================================
# Gin Server Settings
# =============================================
# Use 'debug' for local development. Switch to 'release' in EC2
GIN_MODE=debug
PORT=8080

# =============================================
# Database Settings (PostgreSQL)
# =============================================
# Local execution without docker: localhost
# Running via Doker Compose: postgres (matches the docker-compose service name)
DB_HOST=postgres
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password
DB_NAME=course_selection_db

# ==============================================================================
# Security & JWT Tokens 
# ==============================================================================
# A long, random string used to sign user auth tokens
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_HOURS=24
